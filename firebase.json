{
  "hosting": {
    "site": "igdrsudsubang",
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      ".git/**",
      "**/.git/**",
      ".github/**",
      "**/.github/**",
      "**/node_modules/**",
      "test-results/**",
      "playwright-report/**",
      "Kode.gs",
      "appsscript.json",
      "package.json",
      "package-lock.json",
      "AGENTS.md",
      "prd.md",
      "README.md",
      "qc-test.spec.js"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/Index.html"
      }
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      }
    ]
  }
}
